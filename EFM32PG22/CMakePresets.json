{
    "version": 6,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 25,
      "patch": 0
    },
    "configurePresets": [
      {
           "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/arm-none-eabi-gcc.cmake",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
      },        {
            "name": "debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",

                "PROJECT_ORIGINAL_NAME": "EFM32PG22"

                

            }
        },
        {
            "name": "release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",

                "PROJECT_ORIGINAL_NAME": "EFM32PG22"

          
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "hidden": true,
            "configurePreset": "debug"
        },
        {
            "name": "Debug",
            "displayName": "Build Debug",
            "inherits": "default"
        },
        {
            "name": "Release",
            "displayName": "Build Release",
            "inherits": "default",
            "configurePreset": "release"
        }
    ]
  }