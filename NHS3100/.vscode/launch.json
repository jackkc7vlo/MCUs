    "version": "0.2.0",
    "projectName": "NHS3100",
    "configurations": [
        {
            "cwd": "${workspaceFolder}",
            "executable": "./build/debug/NHS3100.elf",
            "name": "JLink launch",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
            "armToolchainPath": "/usr/bin",
            "device": "NHS3100",
            "interface": "swd",
            "serialNumber": "", // add J-Link serial number if having multiple attached the same time.
            "runToEntryPoint": "main",
            "svdFile": "./device/NHS3100.svd",
            "showDevDebugOutput": "raw"
        },
        {
            "cwd": "${workspaceFolder}",
            "executable": "./build/release/NHS3100.elf",
            "name": "JLink launch (Release)",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "serverpath": "/opt/SEGGER/JLink/JLinkGDBServer",
            "armToolchainPath": "/usr/bin",
            "device": "NHS3100",
            "interface": "swd",
            "serialNumber": "", // add J-Link serial number if having multiple attached the same time.
            "runToEntryPoint": "main",
            "svdFile": "./device/NHS3100.svd",
            "showDevDebugOutput": "raw"
        }
    ]
}
