{
    "configurations": [
    {
            "name": "OpenOCD Debug (Windows)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "./build/Debug/Nucleo-L412RB.elf", // Or specify path to your .elf file
            "servertype": "openocd",
            "serverpath": "C:\\OpenOCD\\bin\\openocd.exe", // Path to OpenOCD executable on Windows
            "gdbPath": "arm-none-eabi-gdb.exe", // Ensure this is in your system's PATH, or provide full path
            "configFiles": [
                "interface/stlink.cfg", // Replace with your probe's config file
                "target/stm32l4x.cfg"  // Replace with your target's config file
            ],
            "searchDir": [
                "C:/openocd/scripts" // Path to OpenOCD scripts folder on Windows
            ],
            "device": "STM32L412RB",
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/device/STM32L412.svd",
            "showDevDebugOutput": "raw"
        },
        {
            "cwd": "${workspaceRoot}",
            "executable": "./build/Debug/Nucleo-L412RB.elf",
            "name": "OpenOCD Debug (Linux)",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "/usr/bin/openocd",
            "configFiles": [
                "debug.cfg"
            ],
            "searchDir": [
                "/usr/share/openocd/scripts" 
            ],
            "device": "STM32L412RB",
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/device/STM32L412.svd",
            "showDevDebugOutput": "raw"
        }
        
    ]
}