{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OpenOCD Debug (Windows)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "./build/Debug/Nucleo-L412RB.elf", // Or specify path to your .elf file
            "servertype": "openocd",
            "serverpath": "C:\\OpenOCD\\bin\\openocd.exe", // Path to OpenOCD executable on Windows
            "gdbPath": "arm-none-eabi-gdb.exe", // Ensure this is in your system's PATH, or provide full path
            "configFiles": [
                "interface/stlink.cfg", // Replace with your probe's config file
                "target/stm32l4x.cfg"  // Replace with your target's config file
            ],
            "searchDir": [
                "C:/openocd/scripts" // Path to OpenOCD scripts folder on Windows
            ],
            "device": "STM32L412RB",
            "runToEntryPoint": "main",
            "svdFile": "/home/jack/STMicroelectronics/STM32Cube/STM32CubeProgrammer/SVD/STM32L412.svd",
            "showDevDebugOutput": "raw"
        },

        {
            "cwd": "${workspaceRoot}",
            "executable": "./build/Debug/Nucleo-L412RB.elf",
            "name": "Debug with OpenOCD",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "/usr/bin/openocd",
            "configFiles": [
                "debug.cfg"
            ],
            "searchDir": [
                "/usr/share/openocd/scripts" 
            ],
            "device": "STM32L412RB",
            "runToEntryPoint": "main",
            "svdFile": "/home/jack/STMicroelectronics/STM32Cube/STM32CubeProgrammer/SVD/STM32L412.svd",
            "showDevDebugOutput": "raw"
        },

        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: STM32 Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ]
        }
    ]
}